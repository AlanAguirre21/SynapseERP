SECRET_KEY=change-me
DEBUG=True

DB_NAME=synapse_erp
DB_USER=synapse
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5434

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Clave Fernet para cifrar ConfiguracionPAC.api_key_cifrada (feature 016).
# Generar una propia por entorno, ej.:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FISCAL_ENCRYPTION_KEY=change-me

# Correo saliente (feature 004 · Recuperar contraseña). Con EMAIL_HOST vacío,
# EMAIL_BACKEND por defecto imprime los correos en la consola en vez de
# enviarlos — útil para levantar el entorno sin credenciales SMTP reales.
#
# Para enviar correos reales vía Gmail/Google Workspace:
#   1. Activa la verificación en dos pasos en la cuenta de Gmail que enviará
#      los correos.
#   2. Genera un App Password en https://myaccount.google.com/apppasswords
#      (NUNCA uses la contraseña normal de la cuenta aquí).
#   3. EMAIL_HOST_USER = esa cuenta de Gmail completa (ej. algo@gmail.com).
#      EMAIL_HOST_PASSWORD = el App Password de 16 caracteres generado.
#   4. DEFAULT_FROM_EMAIL debe coincidir con EMAIL_HOST_USER (o con un alias
#      "Enviar como" verificado en esa cuenta) — Gmail rechaza o reescribe el
#      remitente si no coincide con la cuenta autenticada. Si usas Gmail,
#      cambia el valor de abajo a esa misma cuenta.
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@synapse-erp.local
