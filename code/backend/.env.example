# Clave Fernet para cifrar ConfiguracionPAC.api_key_cifrada (feature 016).
# Generar una propia por entorno, ej.:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FISCAL_ENCRYPTION_KEY=change-me

# Correo saliente (feature 004 · Recuperar contraseña). En desarrollo se deja
# vacío: EMAIL_BACKEND por defecto imprime los correos en la consola.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
